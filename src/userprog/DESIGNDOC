    struct child_status *child_status;  /* Our record shared with parent. */
        Where we publish our exit status for the parent.  NULL for
        kernel threads, which also stops them printing exit lines.

    struct list children;               /* Records of our children. */
        One struct child_status per child we exec'd and haven't
        waited for yet.

    struct file *exec_file;             /* Running executable (write denied). */
        Kept open with file_deny_write() while we run; closed in
        process_exit().

    struct list fd_list;                /* Open files of this process. */
        List of struct file_desc.

    int next_fd;                        /* Next fd number to hand out. */
        Starts at 2 since 0 and 1 are the console.

In userprog/process.h:

    struct child_status
      {
        tid_t tid;                    /* Child's thread id. */
        int exit_status;              /* Child's exit status. */
        bool load_success;            /* Did the child load its program? */
        int ref_cnt;                  /* 2 while both alive, then 1, then 0. */
        struct semaphore load_sema;   /* Upped once load() finishes. */
        struct semaphore exit_sema;   /* Upped when the child exits. */
        struct list_elem elem;        /* Elem in parent's children list. */
      };

        Shared by a parent and one child.  Heap-allocated so it
        outlives whichever of the two exits first.

